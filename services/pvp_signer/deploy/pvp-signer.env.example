# Copy to /etc/pvp-signer/pvp-signer.env, root-owned mode 0600.
# systemd reads this file; never commit the configured copy.
PVP_DATABASE=/var/lib/pvp-signer/state.db
PVP_LOG_FILE=/var/log/pvp-signer/service.log
PVP_PORT=8430
PVP_TRUST_PROXY=1
# Exact published client pool identifiers, comma-separated. No wildcards.
PVP_POOL_IDS=
PVP_IDENTITY_HOUR_LIMIT=600
PVP_IP_HOUR_LIMIT=1800
PVP_SESSION_HOUR_LIMIT=30
PVP_TOKEN_TTL=2592000
# Anonymous per-install sessions; invitation lifetime above remains independent.
PVP_DEVICE_TOKEN_TTL=86400
PVP_DEVICE_HOUR_LIMIT=30
# Exact browser origins, comma-separated, e.g. https://play.example.com
# Empty disables cross-origin requests. No wildcards, paths, or trailing slash.
PVP_CORS_ORIGINS=
PVP_OSS_BUCKET=
PVP_OSS_REGION=
PVP_OSS_ACCESS_KEY_ID=
PVP_OSS_ACCESS_KEY_SECRET=
# Set only after verifying this dedicated private bucket NEVER enabled versioning.
# "Suspended" is not sufficient; never change versioning after deployment.
PVP_OSS_VERSIONING=
