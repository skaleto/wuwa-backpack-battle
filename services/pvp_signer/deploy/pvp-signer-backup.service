[Unit]
Description=Verified backup of PVP signer identity database
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/pvp-signer/.venv/bin/python /opt/pvp-signer/backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/pvp-signer
ReadOnlyPaths=/var/lib/pvp-signer
