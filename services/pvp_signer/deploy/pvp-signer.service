[Unit]
Description=Resonance async pool credential signer
After=network.target

[Service]
Type=simple
User=pvp-signer
Group=pvp-signer
WorkingDirectory=/opt/pvp-signer
EnvironmentFile=/etc/pvp-signer/pvp-signer.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/pvp-signer/.venv/bin/python /opt/pvp-signer/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StateDirectory=pvp-signer
StateDirectoryMode=0700
LogsDirectory=pvp-signer
LogsDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/pvp-signer /var/log/pvp-signer
MemoryMax=192M
CPUQuota=25%
TasksMax=32
LimitNOFILE=256
StandardOutput=null
StandardError=journal
SyslogIdentifier=pvp-signer
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
