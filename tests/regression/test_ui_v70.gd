extends SceneTree
const G=preload("res://tests/fixtures/travel_fixture_v64.gd")
const F=preload("res://scripts/crafting/craft.gd")
const GEO=preload("res://scripts/ui/items/art_geometry.gd")
const P=preload("res://scripts/ui/items/icon_projection.gd")
var game
var checks=0
var failures=0
func ck(ok:bool,label:String):
	checks+=1
	if not ok:failures+=1;printerr("FAIL ",label)
func _initialize():call_deferred("run_tests")
func setup():
	game.fusion_view.finish();game.reset_slice();game.run.round=3;game.run.serial=20
	game.run.bags=[]
	for y in range(0,6,2):
		for x in range(0,8,2):game.run.bags.append(game.piece("pouch","b%d-%d"%[x,y],x,y))
	game.run.items=[game.piece("w_sword","i1",2,2),game.piece("mat_43020011","i2",2,1)]
	game.run.stash=[];game.run.primary="i1";game.mouse=Vector2(950,100)
	game.motion.modal_value=0;game.motion.modal_target=0
func run_tests():
	game=G.new();root.add_child(game);await process_frame
	game.set_process(false);game.set_process_input(false);setup()
	ck(game.SKIN.is_chibi() and not game.SKIN.set_skin("original",false),"original skin unavailable")
	for rotation in 4:
		for direction in [Vector2i.LEFT,Vector2i.RIGHT,Vector2i.UP,Vector2i.DOWN]:
			setup();var base=game.run.items[0];base.rotation=rotation
			var occupied=game.inventory.occupied(base);var anchor=occupied[0]
			for cell in occupied:
				if Vector2(cell).dot(Vector2(direction))>Vector2(anchor).dot(Vector2(direction)):anchor=cell
			var near=anchor+direction;game.run.items[1].x=near.x;game.run.items[1].y=near.y
			var entries=F.ready_options(game.run,game.inventory)
			ck(entries.size()==1,"adjacent recipe all sides rotation %d %s"%[rotation,direction])
			ck(game.inline_craft.links(game._craft_view_model()).size()==1,"glowing line agrees with readiness")
	setup();var before=game.run.duplicate(true)
	var start=game._board_to_screen(game._item_rect(game.run.items[1],game.BOARD).get_center())
	game.dragging=game.run.items[1].duplicate(true);game.drag_origin="board";game.drag_offset=Vector2i.ZERO;game.drag_fraction=Vector2.ONE*.5
	game.mouse=start;game._start_held_pose()
	var links=game.inline_craft.links(game._craft_view_model());ck(links.size()==1,"dragging adjacent partner has line")
	game.mouse+=Vector2(7,3);var moved=game.inline_craft.links(game._craft_view_model())
	ck(moved.size()==1 and moved[0].to!=links[0].to,"line endpoint follows continuous pointer within cell")
	game.mouse=Vector2(1400,930);ck(game.inline_craft.links(game._craft_view_model()).is_empty(),"outside board no ready line")
	ck(game.run==before,"dynamic links never purchase or move live items")
	setup();game.inline_craft.refresh(game._craft_view_model());var entry=game.inline_craft.entries[0];var at=entry.rect.get_center()
	for pressed in [true,false]:
		var e=InputEventMouseButton.new();e.position=at;e.button_index=MOUSE_BUTTON_LEFT;e.pressed=pressed;game._input(e)
	ck(game.run.items.size()==1 and game.fusion_view.parts.size()==2,"one click commits pair and presents original two sprites")
	ck(game.fusion_view.output_alpha(game.run.items[0].uid)==0,"result hidden until source convergence")
	var pose=game.fusion_view.parts[0].sprite.transform
	game.fusion_view.advance(.2)
	ck(game.fusion_view.parts[0].sprite.transform==pose,"first whitening phase retains original footprint pose")
	ck(game.fusion_view.parts[0].sprite.material.get_shader_parameter("whiten")>0,"actual alpha-preserving white shader")
	game.fusion_view.advance(.6);ck(game.fusion_view.parts[0].sprite.transform!=pose,"source progressively converges")
	game.fusion_view.advance(.5);ck(not game.fusion_view.active() and game.fusion_view.parts.is_empty(),"presentation cleans up")
	ck(game.run.items.size()==1,"presentation never replays transaction")
	# Cache is generated by the exact geometry implementation, not a looser box.
	var kind="w_sword";var image=Image.new();image.load_png_from_buffer(FileAccess.get_file_as_bytes(game.SKIN.item_path(kind)))
	for turn in 4:
		var cached=GEO.descriptor(kind,turn,image);var fresh=P.descriptor(image,game.SKIN.item_angle(kind)+turn*PI/2,false)
		ck(cached==fresh,"offline exact silhouette rotation "+str(turn))
	print("UI_V70 ",checks," checks, ",failures," failures")
	game.queue_free();await process_frame;quit(1 if failures else 0)
